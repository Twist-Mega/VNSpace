<Window x:Class="VNSpace.AddVNWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Visual Novel" Height="660" Width="500"
        Background="#313338" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">

        <!-- Title field with search button -->
        <TextBlock Text="TITLE" Foreground="#80848e" FontSize="11" Margin="0 0 0 4"/>
        <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
            <TextBox x:Name="titleInput" Background="#1e1f22" Foreground="#dbdee1"
                     BorderBrush="#4e5058" Padding="6" Width="330"
                     CaretBrush="#dbdee1"/>
            <Button x:Name="searchVNDBBtn" Content="Search VNDB" Click="SearchVNDBBtn_Click"
                    Background="#7289da" Foreground="#f2f3f5" BorderBrush="#7289da"
                    Padding="10 6" Margin="8 0 0 0"/>
        </StackPanel>

        <!-- Search status label -->
        <TextBlock x:Name="searchStatusLabel" Foreground="#80848e" FontSize="11"
                   Margin="0 0 0 4" Visibility="Collapsed"/>

        <!-- VNDB search results list -->
        <ListBox x:Name="searchResultsList" Height="140"
                 Background="#1e1f22" Foreground="#dbdee1" BorderBrush="#4e5058"
                 Margin="0 0 0 12" Visibility="Collapsed"
                 SelectionChanged="SearchResultsList_SelectionChanged"/>

        <!-- Company field -->
        <TextBlock Text="COMPANY" Foreground="#80848e" FontSize="11" Margin="0 0 0 4"/>
        <TextBox x:Name="companyInput" Background="#1e1f22" Foreground="#dbdee1"
                 BorderBrush="#4e5058" Padding="6" Margin="0 0 0 12"
                 CaretBrush="#dbdee1"/>

        <!-- Writer field -->
        <TextBlock Text="WRITER" Foreground="#80848e" FontSize="11" Margin="0 0 0 4"/>
        <TextBox x:Name="writerInput" Background="#1e1f22" Foreground="#dbdee1"
                 BorderBrush="#4e5058" Padding="6" Margin="0 0 0 12"
                 CaretBrush="#dbdee1"/>

        <!-- VNDB ID field -->
        <TextBlock Text="VNDB ID (filled automatically, or enter manually e.g. v17)" Foreground="#80848e" FontSize="11" Margin="0 0 0 4"/>
        <TextBox x:Name="vndbIdInput" Background="#1e1f22" Foreground="#dbdee1"
                 BorderBrush="#4e5058" Padding="6" Margin="0 0 0 20"
                 CaretBrush="#dbdee1"/>

        <!-- Cover Image field -->
        <TextBlock Text="COVER IMAGE (OPTIONAL)" Foreground="#80848e" FontSize="11" Margin="0 0 0 4"/>
        <StackPanel Orientation="Horizontal" Margin="0 0 0 20">
            <TextBox x:Name="coverPathInput" Background="#1e1f22" Foreground="#dbdee1"
             BorderBrush="#4e5058" Padding="6" Width="330" IsReadOnly="True"
             CaretBrush="#dbdee1"/>
            <Button x:Name="browseCoverBtn" Content="Browse" Click="BrowseCoverBtn_Click"
            Background="#4e5058" Foreground="#f2f3f5" BorderBrush="#4e5058"
            Padding="10 6" Margin="8 0 0 0"/>
        </StackPanel>

        <!-- Confirm and cancel buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="cancelBtn" Content="Cancel" Click="CancelBtn_Click"
                    Background="#4e5058" Foreground="#dbdee1" BorderBrush="#4e5058"
                    Padding="16 6" Margin="0 0 8 0"/>
            <Button x:Name="confirmBtn" Content="Add VN" Click="ConfirmBtn_Click"
                    Background="#23a55a" Foreground="#f2f3f5" BorderBrush="#23a55a"
                    Padding="16 6"/>
        </StackPanel>

    </StackPanel>
</Window>